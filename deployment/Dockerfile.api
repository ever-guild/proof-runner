FROM node:22-alpine AS build

WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api ./apps/api
COPY packages/schema ./packages/schema
COPY packages/receipt ./packages/receipt
COPY packages/metadata ./packages/metadata
COPY skills/node-typescript ./skills/node-typescript
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @ever-guild/proof-runner-api... build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app /app
COPY deployment/backup-sqlite.mjs /usr/local/bin/backup-sqlite.mjs
EXPOSE 8787
CMD ["node", "apps/api/dist/index.js"]
