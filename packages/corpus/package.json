{
  "name": "@ever-guild/proof-runner-corpus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "vocabulary",
    "suites",
    "profiles",
    "cases",
    "index",
    "manifests",
    "adapters",
    "generators",
    "quarantine",
    "SPEC.md",
    "VERSION"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "pretest": "pnpm --filter @ever-guild/proof-runner-schema build && tsc -p tsconfig.json",
    "test": "mkdir -p tmp && TMPDIR=./tmp vitest run --config ../../vitest.packages.config.ts --no-file-parallelism",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ever-guild/proof-runner-schema": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "5.8.3",
    "vitest": "4.1.10"
  }
}
