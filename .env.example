DATABASE_PATH=
PROOF_RUNNER_API_HOST=127.0.0.1
PROOF_RUNNER_API_PORT=8787
# Private runner control-plane URL used by the API to dispatch and cancel runs.
PROOF_RUNNER_RUNNER_URL=
# Private API URL used by the runner control plane for heartbeat and terminal-result callbacks.
PROOF_RUNNER_API_URL=
PROOF_RUNNER_BEARER_TOKEN=
PROOF_RUNNER_RECEIPT_KEY_ID=receipt-2026-07
# PEM-encoded Ed25519 signing key. This must be a dedicated key, never a payment wallet key.
PROOF_RUNNER_RECEIPT_PRIVATE_KEY=
# JSON array of prior public keys retained during key rotation, for example:
# [{"keyId":"receipt-2026-06","publicKeyPem":"-----BEGIN PUBLIC KEY-----\\n..."}]
PROOF_RUNNER_RECEIPT_VERIFICATION_KEYS=[]
PUBLIC_BASE_URL=
RUN_QUEUE_CAPACITY=
RAW_LOG_TTL_HOURS=
