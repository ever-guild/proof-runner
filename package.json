{
  "name": "@ever-guild/proof-runner-workspace",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Product repository managed through the multi-agent harness in proof-runner-agent.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && pnpm -r build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint src .storybook vite.config.ts vitest.ui.config.ts && pnpm -r lint",
    "pretest": "pnpm --filter @ever-guild/proof-runner-schema build",
    "test": "vitest run --config vitest.ui.config.ts && pnpm run test:storybook && pnpm -r test && pnpm run test:deployment",
    "test:deployment": "node --test deployment/test/*.test.mjs",
    "secrets": "node deployment/provision-secrets.mjs",
    "test:storybook": "vitest run --config vite.config.ts",
    "pretypecheck": "pnpm --filter @ever-guild/proof-runner-schema build",
    "typecheck": "tsc -p tsconfig.ui.json && pnpm -r typecheck"
  },
  "type": "module",
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "9.32.0",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.3",
    "@storybook/react": "^10.5.3",
    "@storybook/react-vite": "^10.5.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "eslint": "9.32.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.22",
    "storybook": "^10.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
