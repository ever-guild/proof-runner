# Hostname only: do not include https://, a path, query, or fragment.
# Caddy obtains and renews the certificate for this public DNS name.
PROOF_RUNNER_DOMAIN=proofrunner.example.com

# Inject these through the deployment secret manager or a host-only .env file.
# Do not commit actual values.
PROOF_RUNNER_BEARER_TOKEN=
PROOF_RUNNER_RECEIPT_KEY_ID=receipt-YYYY-MM
PROOF_RUNNER_RECEIPT_PRIVATE_KEY=
PROOF_RUNNER_RECEIPT_VERIFICATION_KEYS=[]
PROOF_RUNNER_BACKUP_PATH=/srv/proof-runner-backups
PROOF_RUNNER_BACKUP_RETENTION_DAYS=14
PROOF_RUNNER_BACKUP_INTERVAL_SECONDS=86400

# Built on the dedicated worker host before the runner starts.
PROOF_RUNNER_RUNTIME_IMAGE=proof-runner-node:1
